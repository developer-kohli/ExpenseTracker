# ExpenseTracker – Database Configuration Example
# Copy this file to config/db.properties and set your MySQL credentials.

db.driver   = com.mysql.cj.jdbc.Driver
db.url      = jdbc:mysql://localhost:3306/expense_tracker?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
db.user     = root
db.password = your_mysql_password
